{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Thin Worker + ASSETS for Almost Christmas. Local dev and dry-run only — no
  // custom domain routes until Infra preview after Armand-go (Production UIT).
  //
  // Layout: static files at the repository root. Wrangler uploads that same
  // root (`assets.directory`) with selective `run_worker_first` so CSS/JS/fonts
  // are served from ASSETS at the edge (better TTFB), while HTML navigations
  // and retired /kerst paths still hit the Worker for Observability + redirects.
  // `.assetsignore` drops repo metadata from the asset upload.
  //
  // Hosts: xmas.soholocal.nl (canonical in HTML/sitemap) and almost-xmas.soholocal.nl
  // both map to this Worker and serve the same content (no inter-host 301).
  "name": "xmas-countdown",
  "main": "worker.js",
  // Only the custom domains serve this site. Without these two keys Wrangler
  // defaults to publishing <name>.<subdomain>.workers.dev (world readable) and
  // a preview URL for every version upload.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-25",
  "build": {
    "command": "node scripts/generate-build-info.js"
  },
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Worker-first for document + retired paths only. Everything else (CSS, JS,
    // fonts, images) is asset-first so it skips Worker CPU and picks up _headers.
    "run_worker_first": ["/", "/index.html", "/kerst", "/kerst/*"],
    "html_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
